<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Root element: the directory of national parks -->
  <xs:element name="NationalParks">
    <xs:complexType>
      <xs:sequence>
        <!-- One or more national parks; all have the same structure -->
        <xs:element name="NationalPark" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <!-- Child elements must appear in this (left-to-right) order -->
            <xs:sequence>
              <!-- Exactly one name per park -->
              <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1" />
              <!-- At least one phone number; multiple phones are allowed -->
              <xs:element name="Phone" type="xs:string" minOccurs="1" maxOccurs="unbounded" />
              <!-- Exactly one address per park -->
              <xs:element name="Address" minOccurs="1" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Number" type="xs:string" />
                    <xs:element name="Street" type="xs:string" />
                    <xs:element name="City" type="xs:string" />
                    <xs:element name="State" type="xs:string" />
                    <xs:element name="Zip" type="xs:string" />
                  </xs:sequence>
                  <!-- Required attribute: must be given on every Address -->
                  <xs:attribute name="NearestAirport" type="xs:string" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <!-- Optional (implied) attribute: given for some parks only -->
            <xs:attribute name="Rating" type="xs:decimal" use="optional" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
